# VerifyAI Platform Environment Configuration Example
# Copy to .env for local runtime configuration

APP_NAME="VerifyAI — AICTE Application Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="sqlite:///./verifyai.db"

# Document Storage Vault (Isolated non-public filesystem)
STORAGE_VAULT_PATH="./vault/documents"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# OCR Configuration
ENABLE_OCR=true
TESSERACT_CMD="" # Leave empty for auto-detection in PATH or fallback to PyMuPDF heuristic

# Security & Tokens
SECRET_KEY="verifyai-prototype-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
